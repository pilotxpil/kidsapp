PORT=3001
# Local Docker: mongodb://localhost:27017/kidsapp
# MongoDB Atlas (separate DB on shared cluster): mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kidsapp?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/kidsapp
JWT_SECRET=change-me-in-production
NODE_ENV=development
# Synced from apps/mobile/app.json by deploy/vm/sync-store-version.sh (also run by deploy.sh)
STORE_VERSION_ANDROID=1.1.4
STORE_VERSION_IOS=1.1.4

# ── Production extras (all optional; features degrade gracefully when unset) ──
# Password reset emails (any SMTP provider, e.g. Gmail app password, Resend, SES)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KidsQuest <no-reply@kids.synaboard.com>"
SUPPORT_EMAIL=support@kids.synaboard.com
# Remote switch for parent-screen ads (default on for free families)
ADS_ENABLED=true
# Families created before this date are "founders" (premium forever)
FOUNDER_CUTOFF=2026-12-01T00:00:00Z
# Local testing against a copy of production data: never contact real devices
# PUSH_DISABLED=true
# CRON_DISABLED=true

# Content admin page at /admin (riddles, daily words, learning packs). 24+ chars; unset = admin disabled.
# Generate: openssl rand -hex 24
ADMIN_TOKEN=

# Google Play Billing: base64 of the Play service account JSON ("View financial data" permission).
# base64 -i play-service-account.json | tr -d '\n'
GOOGLE_PLAY_SA_B64=
