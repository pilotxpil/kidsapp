  "title": { "he": "אנגלית — סיפור השועל", "en": "The Tale of the Fox" },
  "category": "english",
  "grade": 3,
  "tags": ["reading", "comprehension", "story", "english"],
  "defaultPoints": 5,
  "activities": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": {
        "text": "קראו: \"A clever fox walked through the forest. He was looking for food.\"\nמה השועל חיפש?"
      },
      "options": [
        { "id": "a", "text": "חבר" },
        { "id": "b", "text": "אוכל" },
        { "id": "c", "text": "נהר" }
      ],
      "answer": "b",
      "explanation": { "he": "looking for food = חיפש אוכל." }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": {
        "text": "קראו: \"The fox saw grapes high on a vine. He jumped again and again but could not reach them.\"\nאיך הרגיש השועל?"
      },
      "options": [
        { "id": "a", "text": "שמח" },
        { "id": "b", "text": "עייף וישנוני" },
        { "id": "c", "text": "מתוסכל" }
      ],
      "answer": "c",
      "explanation": { "he": "הוא לא הצליח להגיע לענבים — מתוסכל (frustrated)." }
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": {
        "text": "השועל אמר: \"Those grapes are probably sour anyway.\"\nמה הכוונה?"
      },
      "options": [
        { "id": "a", "text": "הענבים מתוקים מאוד" },
        { "id": "b", "text": "השועל מעמיד פנים שהוא לא רוצה אותם" },
        { "id": "c", "text": "השועל מצא אוכל טוב יותר" }
      ],
      "answer": "b",
      "explanation": { "he": "זו משל הענבים החמוצים — מעמידים פנים שלא רצינו מה שלא השגנו." }
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": {
        "text": "מה המסר של הסיפור?"
      },
      "options": [
        { "id": "a", "text": "תמיד צריך לחלוק אוכל" },
        { "id": "b", "text": "קל לזלזל במה שלא מצליחים להשיג" },
        { "id": "c", "text": "שועלים לא יודעים לקפוץ" }
      ],
      "answer": "b",
      "explanation": { "he": "מי שלא מצליח — לפעמים אומר שהוא לא רצה בכלל." }
    }
  ]
}
