      "prompt": { "text": "מלבן באורך 12 ס״מ ורוחב 7 ס״מ. מה ההיקף?" },
      "options": [
        { "id": "a", "text": "38 ס״מ" },
        { "id": "b", "text": "84 ס״מ" },
        { "id": "c", "text": "19 ס״מ" }
