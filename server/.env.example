PORT=3001
# Local Docker: mongodb://localhost:27017/kidsapp
# MongoDB Atlas (separate DB on shared cluster): mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kidsapp?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/kidsapp
JWT_SECRET=change-me-in-production
NODE_ENV=development
# Synced from apps/mobile/app.json by deploy/vm/sync-store-version.sh (also run by deploy.sh)
STORE_VERSION_ANDROID=1.1.1
STORE_VERSION_IOS=1.1.1
